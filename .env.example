# First Light — environment template. Copy to .env for local dev; never commit real values.
# Production secrets are set with `wrangler secret put <NAME>` (see docs/ARCHITECTURE.md).

# Workers AI (OpenAI-compatible REST endpoint) — ADR-0003
AI_ACCOUNT_ID=your-cloudflare-account-id
AI_API_TOKEN=your-cloudflare-api-token
AI_MODEL=@cf/openai/gpt-oss-120b

# Email (Resend) — ADR-0004
RESEND_API_KEY=your-resend-api-key

# Better Auth — generate a unique high-entropy secret (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:5173
# Google OAuth callback for local dev: http://localhost:5173/api/auth/callback/google

# Google OAuth — ADR-0005
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# News sources — docs/DATA_SOURCES.md
GUARDIAN_API_KEY=your-guardian-open-platform-key

# App
APP_ORIGIN=http://localhost:5173
